#!/usr/bin/env bash
#
# secret-keeper-update — check for, stage, and install Secret Keeper updates.
#
# Run by the launchd agent com.secretkeeper.updater, by `Check for Updates…` in
# the menu bar, and by hand. Safe to run concurrently (flock-style lock dir).
#
# Design notes:
#   * The script re-execs from a temp copy so it can replace its own file (and
#     the .app bundle it lives in) without bash re-reading a half-swapped file.
#   * An update is downloaded and verified first, then *staged*. It is only
#     swapped in when the vault is idle — locked, with no materialized grants —
#     so an update never yanks a live .env.local out from under a running agent.
#     A staged-but-deferred update is applied by a later run.
#
set -uo pipefail

# ---------------------------------------------------------------- self re-exec
if [ "${SK_UPDATER_REEXEC:-0}" != "1" ]; then
  _self="$(mktemp -t secret-keeper-update)" || exit 1
  if ! cat "$0" > "$_self" 2>/dev/null; then rm -f "$_self"; exit 1; fi
  chmod +x "$_self"
  export SK_UPDATER_REEXEC=1
  export SK_UPDATER_ORIGIN="$0"
  exec /bin/bash "$_self" "$@"
fi
case "$0" in
  */secret-keeper-update*) trap 'rm -f "$0"' EXIT ;;
esac

# --------------------------------------------------------------------- globals
SUPPORT_DIR="$HOME/Library/Application Support/SecretKeeper"
UPD_DIR="$SUPPORT_DIR/updater"
CONFIG="$UPD_DIR/config.json"
LAST_CHECK="$UPD_DIR/last-check"
STAGE_DIR="$UPD_DIR/staged"
STAGED_META="$UPD_DIR/staged.json"
LOCK_DIR="$UPD_DIR/.lock"
LOG_DIR="$HOME/Library/Logs/SecretKeeper"
LOG="$LOG_DIR/updater.log"
SOCKET="$SUPPORT_DIR/secret-keeper.sock"
GRANTS_DIR="$SUPPORT_DIR/grants"

DEFAULT_REPO="roie/secret-keeper"
DEFAULT_BASE_URL="https://github.com"
DEFAULT_CHANNEL="stable"
DEFAULT_INTERVAL=86400
# Narrowed to the installed path once config is read, so a second copy of
# Secret Keeper elsewhere on disk is never the one we quit.
PROC_PATTERN="Secret Keeper.app/Contents/MacOS/SecretKeeperApp"
DEFER_MAX_SECONDS=604800   # 7 days

MODE="run"          # run | check
FORCE=0             # skip the idle check and the interval throttle
USER_INITIATED=0
QUIET=0
CHANNEL_OVERRIDE=""

usage() {
  cat <<'USAGE'
Usage: secret-keeper-update [options]

  --check             Report what an update would do; change nothing.
  --force             Install even if the vault is unlocked or in use, and
                      ignore the daily check interval.
  --user-initiated    Human asked for this: talk to stdout, quit the app
                      politely via Apple Events, ignore the interval.
  --channel <name>    Override the update channel (stable | edge).
  --quiet             Log only; no stdout.
  -h, --help          Show this help.

Exit codes: 0 up to date / updated / staged, 1 error, 2 bad usage.
USAGE
}

while [ $# -gt 0 ]; do
  case "$1" in
    --check) MODE="check"; shift ;;
    --force) FORCE=1; shift ;;
    --user-initiated) USER_INITIATED=1; shift ;;
    --channel) CHANNEL_OVERRIDE="${2:-}"; shift 2 ;;
    --quiet) QUIET=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "secret-keeper-update: unknown option '$1'" >&2; usage >&2; exit 2 ;;
  esac
done

mkdir -p "$UPD_DIR" "$LOG_DIR" 2>/dev/null

# ------------------------------------------------------------------- utilities
log() {
  printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >> "$LOG" 2>/dev/null
  if [ "$QUIET" -eq 0 ] && [ "$USER_INITIATED" -eq 1 ]; then
    printf '%s\n' "$*"
  fi
}

say() {  # user-facing line (stdout only), always logged
  log "$*"
  if [ "$QUIET" -eq 0 ] && [ "$USER_INITIATED" -eq 0 ] && [ -t 1 ]; then
    printf '%s\n' "$*"
  fi
}

die() { log "ERROR: $*"; exit 1; }

rotate_log() {
  [ -f "$LOG" ] || return 0
  local size
  size="$(wc -c < "$LOG" 2>/dev/null | tr -d ' ')"
  [ -n "$size" ] || return 0
  [ "$size" -gt 1048576 ] || return 0
  mv -f "$LOG" "$LOG.1" 2>/dev/null || true
}

notify() {  # notify <title> <message>  — best effort, never fatal
  /usr/bin/osascript -e "display notification \"${2//\"/\\\"}\" with title \"${1//\"/\\\"}\"" \
    >/dev/null 2>&1 || true
}

# Flat-JSON string reader: json_str '<json text>' key
json_str() {
  printf '%s' "$1" | tr ',{}' '\n\n\n' \
    | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" | head -1
}

# Flat-JSON bare (number/bool) reader
json_raw() {
  printf '%s' "$1" | tr ',{}' '\n\n\n' \
    | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\([A-Za-z0-9._-]*\).*/\1/p" | head -1
}

read_file() { cat "$1" 2>/dev/null; }

# ------------------------------------------------------------ version compare
# vfield <dotted> <n>  -> numeric field or 0
vfield() {
  local f
  f="$(printf '%s' "$1" | cut -d. -f"$2")"
  case "$f" in ''|*[!0-9]*) printf '0' ;; *) printf '%s' "$f" ;; esac
}

# version_cmp A B -> prints -1 | 0 | 1  (semver core, then prerelease rank)
version_cmp() {
  local a b acore bcore apre bpre i x y an bn
  a="${1%%+*}"; b="${2%%+*}"
  acore="${a%%-*}"; bcore="${b%%-*}"
  case "$a" in *-*) apre="${a#*-}" ;; *) apre="" ;; esac
  case "$b" in *-*) bpre="${b#*-}" ;; *) bpre="" ;; esac

  i=1
  while [ "$i" -le 3 ]; do
    x="$(vfield "$acore" "$i")"; y="$(vfield "$bcore" "$i")"
    if [ "$x" -gt "$y" ]; then printf '1'; return; fi
    if [ "$x" -lt "$y" ]; then printf -- '-1'; return; fi
    i=$((i + 1))
  done

  # Equal cores: a release outranks any prerelease of the same core.
  if [ -z "$apre" ] && [ -n "$bpre" ]; then printf '1'; return; fi
  if [ -n "$apre" ] && [ -z "$bpre" ]; then printf -- '-1'; return; fi
  if [ "$apre" = "$bpre" ]; then printf '0'; return; fi

  # Both prereleases: compare the trailing integer (edge.41 vs edge.42).
  an="$(printf '%s' "$apre" | sed 's/.*[^0-9]\([0-9][0-9]*\)$/\1/')"
  bn="$(printf '%s' "$bpre" | sed 's/.*[^0-9]\([0-9][0-9]*\)$/\1/')"
  case "$an" in ''|*[!0-9]*) an=0 ;; esac
  case "$bn" in ''|*[!0-9]*) bn=0 ;; esac
  if [ "$an" -gt "$bn" ]; then printf '1'; return; fi
  if [ "$an" -lt "$bn" ]; then printf -- '-1'; return; fi
  printf '0'
}

# is_newer <candidate-ver> <candidate-build> <installed-ver> <installed-build>
is_newer() {
  local c
  c="$(version_cmp "$1" "$3")"
  [ "$c" = "1" ] && return 0
  [ "$c" = "-1" ] && return 1
  # Same version string: fall back to the monotonic build number.
  local cb ib
  cb="$2"; ib="$4"
  case "$cb" in ''|*[!0-9]*) cb=0 ;; esac
  case "$ib" in ''|*[!0-9]*) ib=0 ;; esac
  [ "$cb" -gt "$ib" ]
}

# ------------------------------------------------------------------ app state
app_is_running() { pgrep -f "$PROC_PATTERN" >/dev/null 2>&1; }

has_active_grants() {
  [ -d "$GRANTS_DIR" ] || return 1
  ls "$GRANTS_DIR"/*.env >/dev/null 2>&1
}

vault_state() {  # prints locked | unlocked | unavailable | unknown
  [ -S "$SOCKET" ] || { printf 'unknown'; return; }
  local resp state
  resp="$(printf '{"id":"updater","method":"status"}\n' \
    | /usr/bin/nc -U "$SOCKET" 2>/dev/null | head -1)"
  [ -n "$resp" ] || { printf 'unknown'; return; }
  state="$(json_str "$resp" state)"
  [ -n "$state" ] && printf '%s' "$state" || printf 'unknown'
}

# True when swapping the bundle right now would disrupt someone.
#
# Active grants are a hard block: replacing the app locks the vault, which wipes
# every materialized env file and .env.local symlink out from under whatever
# agent is using them. An unlocked-but-idle vault only costs a re-unlock, so
# that case gets an escape hatch (below) rather than blocking forever.
vault_is_busy() {
  if has_active_grants; then
    BUSY_REASON="grants are active"
    return 0
  fi
  app_is_running || { rm -f "$UPD_DIR/deferred-since" 2>/dev/null; return 1; }

  case "$(vault_state)" in
    locked|unavailable)
      rm -f "$UPD_DIR/deferred-since" 2>/dev/null
      return 1
      ;;
    unlocked)
      BUSY_REASON="the vault is unlocked"
      ;;
    *)
      # Running but not answering. Assume the worst rather than interrupting.
      BUSY_REASON="the app is running but did not answer a status probe"
      ;;
  esac

  # Escape hatch: a status probe that never recovers must not pin an install
  # forever. After DEFER_MAX_SECONDS with no active grants, take the update.
  local since now
  since="$(read_file "$UPD_DIR/deferred-since" | tr -d ' \n')"
  case "$since" in ''|*[!0-9]*) since=0 ;; esac
  now="$(date +%s)"
  if [ "$since" -eq 0 ]; then
    printf '%s' "$now" > "$UPD_DIR/deferred-since" 2>/dev/null
    return 0
  fi
  if [ $((now - since)) -ge "$DEFER_MAX_SECONDS" ]; then
    log "deferred for $(( (now - since) / 86400 )) days and no grants are active — installing now"
    return 1
  fi
  return 0
}

# --------------------------------------------------------------------- config
REPO="$DEFAULT_REPO"
BASE_URL="$DEFAULT_BASE_URL"
CHANNEL="$DEFAULT_CHANNEL"
APP_PATH=""
INTERVAL="$DEFAULT_INTERVAL"
AUTO_INSTALL="true"

if [ -f "$CONFIG" ]; then
  cfg="$(read_file "$CONFIG")"
  v="$(json_str "$cfg" repo)";     [ -n "$v" ] && REPO="$v"
  v="$(json_str "$cfg" channel)";  [ -n "$v" ] && CHANNEL="$v"
  v="$(json_str "$cfg" base_url)"; [ -n "$v" ] && BASE_URL="$v"
  v="$(json_str "$cfg" app_path)"; [ -n "$v" ] && APP_PATH="$v"
  v="$(json_raw "$cfg" check_interval_seconds)"; [ -n "$v" ] && INTERVAL="$v"
  v="$(json_raw "$cfg" auto_install)";           [ -n "$v" ] && AUTO_INSTALL="$v"
fi
[ -n "$CHANNEL_OVERRIDE" ] && CHANNEL="$CHANNEL_OVERRIDE"
BASE_URL="${SK_UPDATER_BASE_URL:-$BASE_URL}"

if [ -z "$APP_PATH" ]; then
  for cand in "/Applications/Secret Keeper.app" "$HOME/Applications/Secret Keeper.app"; do
    [ -d "$cand" ] && { APP_PATH="$cand"; break; }
  done
fi
[ -n "$APP_PATH" ] || die "Secret Keeper is not installed (no app bundle found)."
[ -d "$APP_PATH" ] || die "Configured app path does not exist: $APP_PATH"
PROC_PATTERN="$APP_PATH/Contents/MacOS/SecretKeeperApp"

case "$INTERVAL" in ''|*[!0-9]*) INTERVAL="$DEFAULT_INTERVAL" ;; esac

INSTALLED_VERSION="$(/usr/bin/defaults read "$APP_PATH/Contents/Info" CFBundleShortVersionString 2>/dev/null)"
INSTALLED_BUILD="$(/usr/bin/defaults read "$APP_PATH/Contents/Info" CFBundleVersion 2>/dev/null)"
[ -n "$INSTALLED_VERSION" ] || INSTALLED_VERSION="0.0.0"
[ -n "$INSTALLED_BUILD" ] || INSTALLED_BUILD="0"

rotate_log

# ----------------------------------------------------------------------- lock
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  # Break a lock left behind by a killed run (older than 1 hour).
  if [ -n "$(find "$LOCK_DIR" -maxdepth 0 -mmin +60 2>/dev/null)" ]; then
    rm -rf "$LOCK_DIR" 2>/dev/null
    mkdir "$LOCK_DIR" 2>/dev/null || { log "another updater run holds the lock"; exit 0; }
  else
    log "another updater run holds the lock"
    exit 0
  fi
fi
trap 'rm -rf "$LOCK_DIR"; rm -f "$0"' EXIT

# ------------------------------------------------------- staged update, if any
staged_version=""; staged_build=""; staged_tag=""
if [ -d "$STAGE_DIR/Secret Keeper.app" ] && [ -f "$STAGED_META" ]; then
  meta="$(read_file "$STAGED_META")"
  staged_version="$(json_str "$meta" version)"
  staged_build="$(json_str "$meta" build)"
  staged_tag="$(json_str "$meta" tag)"
  # A staged build that is no longer newer than what is installed is stale.
  if ! is_newer "$staged_version" "$staged_build" "$INSTALLED_VERSION" "$INSTALLED_BUILD"; then
    log "discarding stale staged update $staged_version ($staged_build)"
    rm -rf "$STAGE_DIR" "$STAGED_META" 2>/dev/null
    staged_version=""; staged_build=""; staged_tag=""
  fi
fi

# --------------------------------------------------------------- apply staged
apply_staged() {
  local new_app="$STAGE_DIR/Secret Keeper.app"
  local parent tmp_new tmp_old was_running=0

  [ -d "$new_app" ] || die "no staged bundle to apply"
  parent="$(dirname "$APP_PATH")"
  if [ ! -w "$parent" ]; then
    log "cannot write to $parent — update stays staged. Re-run the installer to move Secret Keeper somewhere writable."
    notify "Secret Keeper" "Update $staged_version needs permission to write to $parent."
    return 1
  fi

  if app_is_running; then
    was_running=1
    log "quitting Secret Keeper before swap"
    if [ "$USER_INITIATED" -eq 1 ]; then
      /usr/bin/osascript -e 'tell application "Secret Keeper" to quit' >/dev/null 2>&1
    fi
    local waited=0
    while app_is_running && [ "$waited" -lt 10 ]; do sleep 1; waited=$((waited + 1)); done
    if app_is_running; then
      pkill -TERM -f "$PROC_PATTERN" >/dev/null 2>&1
      waited=0
      while app_is_running && [ "$waited" -lt 10 ]; do sleep 1; waited=$((waited + 1)); done
    fi
    if app_is_running; then
      pkill -KILL -f "$PROC_PATTERN" >/dev/null 2>&1
      sleep 1
    fi
  fi

  tmp_new="$parent/.SecretKeeper-new-$$"
  tmp_old="$parent/.SecretKeeper-old-$$"
  rm -rf "$tmp_new" "$tmp_old" 2>/dev/null

  # Copy into the destination directory first so the swap itself is two renames.
  if ! /usr/bin/ditto "$new_app" "$tmp_new"; then
    rm -rf "$tmp_new"; die "failed to copy staged bundle into $parent"
  fi

  if ! mv "$APP_PATH" "$tmp_old"; then
    rm -rf "$tmp_new"; die "failed to move the current bundle aside"
  fi
  if ! mv "$tmp_new" "$APP_PATH"; then
    mv "$tmp_old" "$APP_PATH" 2>/dev/null
    rm -rf "$tmp_new"
    die "failed to move the new bundle into place (rolled back)"
  fi
  rm -rf "$tmp_old" 2>/dev/null

  /usr/bin/xattr -dr com.apple.quarantine "$APP_PATH" 2>/dev/null || true

  # Refresh the installed updater from the bundle it just installed.
  if [ -f "$APP_PATH/Contents/Resources/secret-keeper-update" ]; then
    cp -f "$APP_PATH/Contents/Resources/secret-keeper-update" "$UPD_DIR/secret-keeper-update.new" 2>/dev/null \
      && chmod +x "$UPD_DIR/secret-keeper-update.new" 2>/dev/null \
      && mv -f "$UPD_DIR/secret-keeper-update.new" "$UPD_DIR/secret-keeper-update" 2>/dev/null
  fi

  rm -rf "$STAGE_DIR" "$STAGED_META" "$UPD_DIR/deferred-notified" "$UPD_DIR/deferred-since" 2>/dev/null

  say "Updated Secret Keeper to $staged_version (build $staged_build)."
  notify "Secret Keeper updated" "Now running $staged_version."

  if [ "$was_running" -eq 1 ]; then
    log "relaunching Secret Keeper"
    /usr/bin/open "$APP_PATH" >/dev/null 2>&1 || true
  fi
  return 0
}

# If something is already staged, try to land it before doing any network work.
if [ -n "$staged_version" ]; then
  if [ "$MODE" = "check" ]; then
    say "Update $staged_version (build $staged_build) is downloaded and waiting to install."
    exit 0
  fi
  BUSY_REASON=""
  if [ "$FORCE" -eq 0 ] && vault_is_busy; then
    log "staged update $staged_version deferred — $BUSY_REASON"
    say "Update $staged_version is downloaded. It installs automatically once the vault is locked and no grants are active."
    if [ ! -f "$UPD_DIR/deferred-notified" ]; then
      notify "Secret Keeper update ready" "$staged_version installs automatically once you lock the vault."
      : > "$UPD_DIR/deferred-notified"
    fi
    exit 0
  fi
  apply_staged && exit 0
  exit 1
fi

# ------------------------------------------------------------ interval throttle
now="$(date +%s)"
if [ "$FORCE" -eq 0 ] && [ "$USER_INITIATED" -eq 0 ] && [ "$MODE" != "check" ]; then
  last="$(read_file "$LAST_CHECK" | tr -d ' \n')"
  case "$last" in ''|*[!0-9]*) last=0 ;; esac
  if [ "$last" -gt 0 ] && [ $((now - last)) -lt "$INTERVAL" ]; then
    log "checked $((now - last))s ago (interval ${INTERVAL}s) — skipping"
    exit 0
  fi
fi

# ------------------------------------------------------------- fetch manifest
if [ "$CHANNEL" = "stable" ]; then
  MANIFEST_URL="$BASE_URL/$REPO/releases/latest/download/latest.json"
else
  MANIFEST_URL="$BASE_URL/$REPO/releases/download/$CHANNEL/latest.json"
fi

log "checking $REPO ($CHANNEL) — installed $INSTALLED_VERSION build $INSTALLED_BUILD"
manifest="$(/usr/bin/curl -fsSL --retry 3 --retry-delay 2 --max-time 60 "$MANIFEST_URL" 2>/dev/null)"
if [ -z "$manifest" ]; then
  log "could not fetch $MANIFEST_URL (no releases yet, or offline)"
  printf '%s' "$now" > "$LAST_CHECK" 2>/dev/null
  [ "$MODE" = "check" ] && say "Could not reach the update feed for $REPO ($CHANNEL)."
  exit 0
fi
printf '%s' "$now" > "$LAST_CHECK" 2>/dev/null

new_version="$(json_str "$manifest" version)"
new_build="$(json_str "$manifest" build)"
new_tag="$(json_str "$manifest" tag)"
new_asset="$(json_str "$manifest" asset)"
new_sha="$(json_str "$manifest" sha256)"
min_macos="$(json_str "$manifest" min_macos)"

[ -n "$new_version" ] || die "update manifest has no version field"
[ -n "$new_asset" ] || die "update manifest has no asset field"
[ -n "$new_sha" ] || die "update manifest has no sha256 field — refusing an unverifiable download"
[ -n "$new_tag" ] || new_tag="v$new_version"
[ -n "$new_build" ] || new_build="0"

if ! is_newer "$new_version" "$new_build" "$INSTALLED_VERSION" "$INSTALLED_BUILD"; then
  say "Secret Keeper $INSTALLED_VERSION is up to date."
  exit 0
fi

if [ -n "$min_macos" ]; then
  os_version="$(/usr/bin/sw_vers -productVersion)"
  if [ "$(version_cmp "$os_version" "$min_macos")" = "-1" ]; then
    log "update $new_version needs macOS $min_macos (this Mac runs $os_version) — skipping"
    exit 0
  fi
fi

say "Secret Keeper $new_version is available (installed: $INSTALLED_VERSION)."

if [ "$MODE" = "check" ]; then
  exit 0
fi

if [ "$AUTO_INSTALL" != "true" ]; then
  notify "Secret Keeper $new_version available" "Open Secret Keeper and choose Check for Updates to install."
  exit 0
fi

# ------------------------------------------------------------------- download
ASSET_URL="$BASE_URL/$REPO/releases/download/$new_tag/$new_asset"
work="$(mktemp -d -t secret-keeper-update)" || die "cannot create a temp directory"
cleanup_work() { rm -rf "$work" 2>/dev/null; }

log "downloading $ASSET_URL"
if ! /usr/bin/curl -fsSL --retry 3 --retry-delay 2 --max-time 900 -o "$work/$new_asset" "$ASSET_URL"; then
  cleanup_work; die "download failed: $ASSET_URL"
fi

actual_sha="$(/usr/bin/shasum -a 256 "$work/$new_asset" | awk '{print $1}')"
expected_sha="$(printf '%s' "$new_sha" | tr 'A-Z' 'a-z')"
if [ "$(printf '%s' "$actual_sha" | tr 'A-Z' 'a-z')" != "$expected_sha" ]; then
  cleanup_work
  die "checksum mismatch for $new_asset (expected $expected_sha, got $actual_sha) — refusing to install"
fi
log "checksum verified"

mkdir -p "$work/x" || { cleanup_work; die "cannot create extract dir"; }
if ! /usr/bin/ditto -x -k "$work/$new_asset" "$work/x" 2>/dev/null; then
  cleanup_work; die "failed to expand $new_asset"
fi

extracted="$work/x/Secret Keeper.app"
if [ ! -d "$extracted" ]; then
  extracted="$(find "$work/x" -maxdepth 3 -name 'Secret Keeper.app' -type d 2>/dev/null | head -1)"
fi
[ -n "$extracted" ] && [ -d "$extracted" ] || { cleanup_work; die "no 'Secret Keeper.app' inside $new_asset"; }

/usr/bin/xattr -dr com.apple.quarantine "$extracted" 2>/dev/null || true

if ! /usr/bin/codesign --verify --deep --strict "$extracted" >/dev/null 2>&1; then
  log "signature did not verify after expansion; re-signing ad-hoc (payload already matched the published checksum)"
  /usr/bin/codesign --force --deep --sign - "$extracted" >/dev/null 2>&1
  if ! /usr/bin/codesign --verify --deep --strict "$extracted" >/dev/null 2>&1; then
    cleanup_work; die "could not produce a valid signature for the downloaded bundle"
  fi
fi

if [ ! -x "$extracted/Contents/MacOS/secret-keeper-mcp" ] \
  || [ ! -x "$extracted/Contents/MacOS/SecretKeeperApp" ]; then
  cleanup_work; die "downloaded bundle is missing its executables"
fi

rm -rf "$STAGE_DIR" 2>/dev/null
mkdir -p "$STAGE_DIR" || { cleanup_work; die "cannot create staging dir"; }
if ! /usr/bin/ditto "$extracted" "$STAGE_DIR/Secret Keeper.app"; then
  cleanup_work; rm -rf "$STAGE_DIR"; die "failed to stage the new bundle"
fi
cleanup_work

cat > "$STAGED_META" <<JSON
{
  "version": "$new_version",
  "build": "$new_build",
  "tag": "$new_tag",
  "channel": "$CHANNEL"
}
JSON
rm -f "$UPD_DIR/deferred-notified" "$UPD_DIR/deferred-since" 2>/dev/null

staged_version="$new_version"
staged_build="$new_build"
staged_tag="$new_tag"
log "staged $new_version (build $new_build)"

BUSY_REASON=""
if [ "$FORCE" -eq 0 ] && vault_is_busy; then
  log "deferring install — $BUSY_REASON"
  say "Update $new_version is downloaded. It installs automatically once the vault is locked and no grants are active."
  notify "Secret Keeper update ready" "$new_version installs automatically once you lock the vault."
  : > "$UPD_DIR/deferred-notified"
  exit 0
fi

apply_staged || exit 1
exit 0
